# 本地开发配置模板
#
# 用法：复制为 application-local.yml（同目录），按自己的数据库填写。
# application-local.yml 已在 .gitignore 中，不会进入仓库。
#
# 启动时指定 profile：
#   ./run.sh --spring.profiles.active=local
# 环境变量方式见 README，两者选其一即可。

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/sqljson_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 这里填你自己的口令
