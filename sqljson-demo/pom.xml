<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.chenzhiweiok</groupId>
        <artifactId>sqljson-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>sqljson-demo</artifactId>

    <properties>
        <!-- 应用模块，不是库：不发布到 Central，跳过 GPG/Javadoc 生成以加快本地构建 -->
        <central.skip>true</central.skip>
        <gpg.skip>true</gpg.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <!-- 关键：mvn deploy 时不要把应用模块推到 GitHub Packages -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <packaging>jar</packaging>
    <name>sqljson-demo</name>
    <description>业务示例：用户关系系统（Spring Boot 3 + sqljson-spring 依赖注入）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.chenzhiweiok</groupId>
            <artifactId>sqljson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.chenzhiweiok</groupId>
            <artifactId>sqljson-spring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>user-relation</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>com.demo.relation.DemoApplication</mainClass>
                </configuration>
                <executions>
                    <!-- 不用 spring-boot-starter-parent，就必须显式绑 repackage -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
