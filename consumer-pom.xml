<?xml version="1.0" encoding="UTF-8"?>
<!--
  消费者 POM 模板：在你的项目中复制以下配置即可使用 sqlJson。
  需要先在 ~/.m2/settings.xml 中配置 GitHub 认证（详见 发布.md）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== 你的项目信息（替换成你自己的） ========== -->
    <groupId>com.example</groupId>
    <artifactId>your-project</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sqljson.version>1.0.0</sqljson.version>
    </properties>

    <!-- ========== GitHub Packages 仓库 ========== -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/chenzhiweiok/sqlJson</url>
        </repository>
    </repositories>

    <!-- ========== sqlJson 依赖 ========== -->
    <dependencies>
        <!-- 核心库：JSON SQL 编译器、注解仓库、事务、分页（必选） -->
        <dependency>
            <groupId>io.github.chenzhiweiok</groupId>
            <artifactId>sqljson-core</artifactId>
            <version>${sqljson.version}</version>
        </dependency>

        <!-- Spring 集成：@EnableSqlJson 扫描实体（可选，依赖 Spring Context） -->
        <dependency>
            <groupId>io.github.chenzhiweiok</groupId>
            <artifactId>sqljson-spring</artifactId>
            <version>${sqljson.version}</version>
        </dependency>
    </dependencies>

</project>